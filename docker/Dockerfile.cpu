# Gateway, validators only (no model): email, Luhn cards, IBAN, phone numbers, IPs.
#   docker build -f docker/Dockerfile.cpu -t pii-gateway:cpu .
FROM python:3.12-slim
COPY --from=ghcr.io/astral-sh/uv:0.8 /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PROJECT_ENVIRONMENT=/app/.venv
WORKDIR /app
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-dev --extra serve --no-install-project
COPY src ./src
COPY configs/policy ./configs/policy
RUN uv sync --frozen --no-dev --extra serve \
 && useradd --create-home --uid 10001 gateway
USER gateway
ENV PATH=/app/.venv/bin:$PATH PII_DETECTOR=validators PII_POLICY_DIR=/app/configs/policy
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s CMD python -c "import urllib.request as u; u.urlopen('http://127.0.0.1:8000/health')"
CMD ["uvicorn", "--factory", "pii_gateway.api:create_app", "--host", "0.0.0.0", "--port", "8000"]
