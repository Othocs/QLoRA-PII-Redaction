# Copy to docker/gateway.env (gitignored) and fill in. Generate keys with:
#   python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"   # vault
#   python -c "import secrets; print(secrets.token_hex(24))"                         # API keys
PII_VAULT_KEY=
PII_API_KEY=
PII_RESTORE_KEY=
# Optional: enables POST /proxy (redact -> this OpenAI-compatible LLM -> restore the reply).
# The only outbound route; the upstream only ever receives redacted text.
PII_UPSTREAM_URL=
PII_UPSTREAM_KEY=
PII_UPSTREAM_MODEL=
